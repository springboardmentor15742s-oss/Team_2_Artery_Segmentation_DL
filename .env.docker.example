# Copy to .env beside docker-compose.yml. Generate a long random secret first.
ARTERY_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8081

# Optional outbound alert email (leave blank to use only in-app notifications)
ARTERY_SMTP_HOST=
ARTERY_SMTP_PORT=587
ARTERY_SMTP_USERNAME=
ARTERY_SMTP_PASSWORD=
ARTERY_SMTP_FROM=
ARTERY_SMTP_STARTTLS=true
ARTERY_SMTP_USE_SSL=false

# Required only when using docker-compose.monitoring.yml
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
